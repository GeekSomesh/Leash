{
  "name": "leash",
  "version": "0.1.0",
  "private": true,
  "description": "Leash: a safety layer for money moved by AI agents and the people scams target. Built on PayPal (sandbox) and Claude.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "paypal:spike": "tsx scripts/paypal-sandbox-spike.ts",
    "mcp:smoke": "tsx scripts/mcp-smoke-test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@modelcontextprotocol/server": "2.3.1",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "ag-studio": "3.0.0",
    "ag-studio-react": "3.0.0",
    "drizzle-orm": "0.45.4",
    "mcp-handler": "2.3.0",
    "next": "16.3.6",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
