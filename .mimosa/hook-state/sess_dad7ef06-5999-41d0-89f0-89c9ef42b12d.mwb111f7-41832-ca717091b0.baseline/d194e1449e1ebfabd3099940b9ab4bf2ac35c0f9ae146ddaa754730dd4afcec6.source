// One place that talks to the AI model. Every call:
//   - goes to OpenRouter's OpenAI-compatible chat completions API (plain fetch, no SDK),
//   - uses OPENROUTER_MODEL (default: a free Nemotron variant, so the demo costs nothing),
//   - returns schema-validated JSON (the schema travels in the prompt; the answer is parsed
//     and validated here, because free models don't reliably support structured outputs) or
//     plain text, and fails closed: any refusal, truncation or bad JSON throws
//     AiUnavailableError so callers hold for a person instead of approving.

import { z } from "zod";
import { appBaseUrl } from "@/lib/config";

export const AI_MODEL = "nvidia/nemotron-3-ultra-550b-a55b:free";
// The endpoint is fixed; only the model is configurable (OPENROUTER_MODEL).
const OPENROUTER_BASE = "https://openrouter.ai/api/v1";
const RETRYABLE_STATUS = new Set([429, 500, 502, 503, 504]);

export type Effort = "low" | "medium" | "high";
export type AgentEffort = "low" | "medium" | "high" | "xhigh" | "max";

export function aiConfigured(): boolean {
  return Boolean(process.env.OPENROUTER_API_KEY);
}

const model = () => process.env.OPENROUTER_MODEL || AI_MODEL;

export class AiUnavailableError extends Error {
  readonly name = "AiUnavailableError";
}

// --- OpenAI-compatible shapes (minimal, no SDK) ----------------------------------------------

export type ChatToolCall = { id: string; type: "function"; function: { name: string; arguments: string } };
export type ChatMessage =
  | { role: "system" | "user"; content: string }
  | { role: "assistant"; content: string | null; tool_calls?: ChatToolCall[] }
  | { role: "tool"; content: string; tool_call_id: string };
export type ChatTool = { type: "function"; function: { name: string; description: string; parameters: Record<string, unknown> } };

type ChatChoice = { message: { role: "assistant"; content: string | null; tool_calls?: ChatToolCall[] }; finish_reason: string };
type ChatResponse = { id: string; model: string; choices: ChatChoice[] };

async function chat(body: Record<string, unknown>, signal?: AbortSignal): Promise<ChatResponse> {
  const key = process.env.OPENROUTER_API_KEY;
  if (!key) throw new AiUnavailableError("OPENROUTER_API_KEY isn't set.");
  const request = () =>
    fetch(`${OPENROUTER_BASE}/chat/completions`, {
      method: "POST",
      headers: { Authorization: `Bearer ${key}`, "Content-Type": "application/json", "HTTP-Referer": appBaseUrl(), "X-Title": "Leash" },
      body: JSON.stringify({ model: model(), ...body }),
      signal,
    });

  let response: Response;
  try {
    response = await request();
    if (RETRYABLE_STATUS.has(response.status)) {
      await new Promise((resolve) => setTimeout(resolve, 1500));
      response = await request();
    }
  } catch (error) {
    if (error instanceof Error && error.name === "AbortError") throw error;
    throw new AiUnavailableError(`OpenRouter request failed: ${error instanceof Error ? error.message : String(error)}`);
  }

  if (!response.ok) {
    const detail = await response.text().catch(() => "");
    throw new AiUnavailableError(`OpenRouter error ${response.status}: ${detail.slice(0, 300) || response.statusText}`);
  }
  const parsed = (await response.json().catch(() => null)) as ChatResponse | null;
  if (!parsed || !Array.isArray(parsed.choices)) throw new AiUnavailableError("OpenRouter returned an unreadable response.");
  return parsed;
}

const finishProblem = (finishReason: string): string | null =>
  finishReason === "content_filter" ? "The model declined the request (content filter)." : finishReason === "length" ? "The model's answer was cut off." : null;

function choiceOf(response: ChatResponse): ChatChoice {
  const choice = response.choices[0];
  if (!choice) throw new AiUnavailableError("OpenRouter returned no choices.");
  return choice;
}

/** The first balanced {...} object at or after `from`, honoring strings and escapes. */
function firstJsonObject(text: string, from: number): string | null {
  let depth = 0;
  let inString = false;
  let escaped = false;
  for (let i = from; i < text.length; i++) {
    const ch = text[i]!;
    if (inString) {
      if (escaped) escaped = false;
      else if (ch === "\\") escaped = true;
      else if (ch === '"') inString = false;
      continue;
    }
    if (ch === '"') inString = true;
    else if (ch === "{") depth++;
    else if (ch === "}") {
      depth--;
      if (depth === 0) return text.slice(from, i + 1);
    }
  }
  return null;
}

/** Pulls the first JSON object out of a model answer: a fenced block first, then the outermost braces. */
export function extractJson(text: string): unknown {
  const candidates: string[] = [];
  const fenced = text.match(/```(?:json)?\s*([\s\S]*?)```/i);
  if (fenced?.[1]) candidates.push(fenced[1].trim());
  const start = text.indexOf("{");
  if (start >= 0) {
    const balanced = firstJsonObject(text, start);
    if (balanced) candidates.push(balanced);
    const end = text.lastIndexOf("}");
    if (end > start) candidates.push(text.slice(start, end + 1));
  }
  for (const candidate of candidates) {
    try {
      return JSON.parse(candidate) as unknown;
    } catch {
      // Try the next candidate.
    }
  }
  return null;
}

/** Asks the model for JSON matching `schema`. Throws AiUnavailableError on refusal, truncation or invalid output. */
export async function askForJson<Schema extends z.ZodType>(input: {
  schema: Schema;
  system: string;
  prompt: string;
  /** Accepted for call-site compatibility; the model decides how much to reason. */
  effort?: Effort;
  maxTokens?: number;
}): Promise<z.infer<Schema>> {
  const system = `${input.system}

Answer with a single JSON object and nothing else (no prose, no code fences). It must match this JSON schema:
${JSON.stringify(z.toJSONSchema(input.schema))}`;

  const response = await chat({
    messages: [
      { role: "system", content: system },
      { role: "user", content: input.prompt },
    ],
    max_tokens: input.maxTokens ?? 2000,
  });
  const choice = choiceOf(response);
  const problem = finishProblem(choice.finish_reason);
  if (problem) throw new AiUnavailableError(problem);

  const parsed = extractJson(choice.message.content ?? "");
  if (parsed === null || typeof parsed !== "object") throw new AiUnavailableError("The model's answer wasn't valid JSON.");
  const result = input.schema.safeParse(parsed);
  if (!result.success) {
    const issues = result.error.issues.map((issue) => `${issue.path.join(".")}: ${issue.message}`).join("; ");
    throw new AiUnavailableError(`The model's JSON didn't match the schema: ${issues.slice(0, 300)}`);
  }
  return result.data;
}

/** Asks the model for a short piece of text. */
export async function askForText(input: { system: string; prompt: string; effort?: Effort; maxTokens?: number }): Promise<string> {
  const response = await chat({
    messages: [
      { role: "system", content: input.system },
      { role: "user", content: input.prompt },
    ],
    max_tokens: input.maxTokens ?? 1000,
  });
  const choice = choiceOf(response);
  const problem = finishProblem(choice.finish_reason);
  if (problem) throw new AiUnavailableError(problem);
  const text = (choice.message.content ?? "").trim();
  if (!text) throw new AiUnavailableError("The model returned no text.");
  return text;
}

/**
 * One turn of an agent loop driven by someone else (AG Studio's agents): the model sees the
 * conversation and the tools, and answers with text and/or tool calls. The caller runs the
 * tools and sends the results back on the next turn.
 */
export async function runToolTurn(input: {
  system: string;
  messages: ChatMessage[];
  tools: ChatTool[];
  toolChoice: "auto" | "none";
  effort?: AgentEffort;
  maxTokens?: number;
  signal?: AbortSignal;
}): Promise<{ id: string; model: string; message: ChatChoice["message"]; finishReason: string }> {
  const response = await chat(
    {
      messages: [{ role: "system", content: input.system }, ...input.messages],
      ...(input.tools.length > 0 ? { tools: input.tools, tool_choice: input.toolChoice } : {}),
      max_tokens: input.maxTokens ?? 16000,
    },
    input.signal,
  );
  const choice = choiceOf(response);
  return { id: response.id, model: response.model, message: choice.message, finishReason: choice.finish_reason };
}
