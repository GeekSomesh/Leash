# Copy this file to .env.local and fill in the values. .env.local is git-ignored.
# Leash only ever talks to the PayPal SANDBOX. There is no live mode.

# --- PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the sandbox app's webhook settings (used to verify webhook signatures).
PAYPAL_WEBHOOK_ID=

# Sandbox account emails used by the demo (developer.paypal.com > Testing Tools > Sandbox Accounts).
# Each merchant / payee gets paid through PayPal Payouts when Leash approves a payment.
DEMO_MERCHANT_FRESHCART_EMAIL=
DEMO_MERCHANT_ORBITTOYS_EMAIL=
DEMO_PERSON_ARJUN_EMAIL=

# --- AI via OpenRouter (openrouter.ai) ---
# Without a key Leash still runs: the deterministic policy engine and the built-in
# scam / prompt-injection heuristics make every decision, and the AI checks are skipped.
OPENROUTER_API_KEY=
# Optional model override (default: nvidia/nemotron-3-ultra-550b-a55b:free).
OPENROUTER_MODEL=

# --- App ---
# Public base URL, used for PayPal return/cancel URLs and the MCP endpoint shown in the UI.
APP_BASE_URL=http://localhost:3000
# Postgres connection string for production (Render). Leave blank locally to use the
# embedded PGlite database stored in ./.data/pglite.
DATABASE_URL=
# Secret used to protect demo-only admin actions such as resetting the demo data.
LEASH_ADMIN_SECRET=

# --- AG Studio (optional) ---
# Licence key for the /insights report. Without one, AG Studio runs as a trial with a watermark.
# (AG Studio licence keys are meant to ship to the browser; OPENROUTER_API_KEY never does.)
AG_STUDIO=
